  "fixed_sql": [
    {
      "name": "assets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"type\", \"code\"));"
        }
      ]
    },
    {
      "name": "asset_transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"asset_transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"asset_id\" INTEGER NOT NULL REFERENCES assets (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"quantity\" TEXT NOT NULL, \"unit_price_try\" TEXT NULL, \"date\" INTEGER NOT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "price_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"price_cache\" (\"type\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"price_try\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, \"name\" TEXT NULL, \"change_percent\" TEXT NULL, \"as_of\" INTEGER NULL, PRIMARY KEY (\"type\", \"code\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "kap_disclosures",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"kap_disclosures\" (\"id\" TEXT NOT NULL, \"symbol\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"summary\" TEXT NULL, \"url\" TEXT NULL, \"published_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "portfolio_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"portfolio_snapshots\" (\"day\" TEXT NOT NULL, \"value_try\" TEXT NOT NULL, \"cost_try\" TEXT NULL, \"usd_try\" TEXT NULL, \"eur_try\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "asset_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"asset_snapshots\" (\"day\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"quantity\" TEXT NOT NULL, \"price_try\" TEXT NOT NULL, PRIMARY KEY (\"day\", \"type\", \"code\"));"
        }
      ]
    },
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"target\" TEXT NOT NULL, \"currency\" TEXT NULL, \"asset_type\" TEXT NULL, \"asset_code\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    }
  ]
